{
  "name": "🚀 Forestech Enterprise",
  "image": "node:20-bullseye",
  
  // 🎯 Puertos completos
  "forwardPorts": [3000, 5173, 4000, 9099, 5001, 8080, 8085],
  
  "portsAttributes": {
    "3000": {"label": "🍽️ Alimentacion", "onAutoForward": "notify"},
    "5173": {"label": "⛽ Combustibles", "onAutoForward": "notify"}, 
    "4000": {"label": "🔥 Firebase UI", "onAutoForward": "notify"},
    "9099": {"label": "🔥 Auth Emulator", "onAutoForward": "silent"},
    "5001": {"label": "🔥 Functions", "onAutoForward": "silent"},
    "8080": {"label": "🔥 Firestore", "onAutoForward": "silent"},
    "8085": {"label": "🔥 Firebase UI", "onAutoForward": "silent"}
  },
  
  // 📦 Extensions enterprise completas
  "customizations": {
    "vscode": {
      "extensions": [
        // Core development
        "ms-vscode.vscode-typescript-next",
        "esbenp.prettier-vscode", 
        "dbaeumer.vscode-eslint",
        
        // GitHub ecosystem
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-github-actions",
        "github.codespaces",
        
        // AI Tools
        "anthropic.claude-code",
        
        // React & Frontend
        "bradlc.vscode-tailwindcss",
        "formulahendry.auto-rename-tag",
        "christian-kohler.path-intellisense",
        
        // Firebase & Cloud
        "toba.vsfire",
        
        // Productivity
        "usernamehw.errorlens",
        "christian-kohler.npm-intellisense",
        "ms-vscode.live-server"
      ],
      
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "typescript.preferences.preferTypeOnlyAutoImports": true,
        "workbench.startupEditor": "none",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  // 🚀 Enterprise setup optimizado
  "postCreateCommand": "bash .devcontainer/setup-enterprise.sh",
  "updateContentCommand": "bash .devcontainer/update-enterprise.sh",
  
  // 🌍 Variables enterprise con secrets
  "containerEnv": {
    "NODE_ENV": "development",
    "npm_config_cache": "/workspaces/forestech/.npm-cache",
    "npm_config_prefer_offline": "true",
    "npm_config_progress": "false",
    "npm_config_audit": "false",
    "FIREBASE_PROJECT": "liquidacionapp-62962",
    "VITE_FIREBASE_PROJECT_ID": "liquidacionapp-62962"
  },

  // 🔒 Root user optimizado
  // "remoteUser": "vscode", ← COMENTADO - causa errores
  
  // 🔧 Features adicionales
  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "ppa": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    }
  },

  // 📦 Montajes optimizados
  "mounts": [
    "source=forestech-npm-cache,target=/workspaces/forestech/.npm-cache,type=volume",
    "source=forestech-yarn-cache,target=/workspaces/forestech/.yarn-cache,type=volume",
    "source=forestech-firebase-cache,target=/workspaces/forestech/.firebase,type=volume"
  ],

  // ⚙️ Configuración avanzada
  "shutdownAction": "stopContainer",
  "updateRemoteUserUID": false,
  
  // 🔐 Secrets mapping (requiere configuración en GitHub)
  "secrets": {
    "GEMINI_API_KEY": {
      "description": "Gemini API key for AI tools"
    },
    "FIREBASE_TOKEN": {
      "description": "Firebase deployment token"
    }
  }
}