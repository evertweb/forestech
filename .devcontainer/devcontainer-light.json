{
  "name": "Forestech Light - Económico",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-18-bullseye",
  
  // 🏗️ Recursos mínimos pero suficientes
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  
  // 🔧 Features esenciales SOLAMENTE
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "configureZshAsDefaultShell": false,
      "installOhMyZsh": false,
      "upgradePackages": false,
      "username": "vscode"
    }
  },

  // 🚀 Puertos necesarios
  "forwardPorts": [3000, 5173, 9005, 8080, 9099],
  
  // 📦 Extensiones MÍNIMAS esenciales
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "formulahendry.auto-rename-tag",
        "ms-vscode.vscode-json",
        "github.copilot",
        "firebase.firebase-vscode"
      ],
      
      "settings": {
        "workbench.colorTheme": "Default Dark+",
        "editor.fontSize": 14,
        "editor.formatOnSave": true,
        "files.autoSave": "afterDelay",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  // 🚀 Scripts LIGEROS sin instalaciones pesadas
  "postCreateCommand": "bash .devcontainer/setup-light.sh",

  // 🔒 Usuario
  "remoteUser": "vscode",

  // 🌍 Variables mínimas
  "containerEnv": {
    "NODE_ENV": "development",
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },

  // ⚙️ Sin keep-alive automático
  "shutdownAction": "stopContainer"
}