{
  "name": "Forestech Root Fix",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-18-bullseye",
  
  // 🚀 Puertos básicos
  "forwardPorts": [3000, 5173, 4000],
  
  "portsAttributes": {
    "3000": {"label": "Alimentacion App"},
    "5173": {"label": "Combustibles App"}, 
    "4000": {"label": "Firebase UI"}
  },
  
  // 📦 Extensions mínimas
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "esbenp.prettier-vscode", 
        "dbaeumer.vscode-eslint"
      ]
    }
  },

  // 🔒 SIN especificar usuario - usar default (root)
  // "remoteUser": "vscode",  ← ESTO CAUSA EL ERROR
  
  // 🌍 Variables mínimas
  "containerEnv": {
    "NODE_ENV": "development"
  },

  // 🔧 Config mínima
  "shutdownAction": "stopContainer"
}