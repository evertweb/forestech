{
  "name": "Forestech Ubuntu Base",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  
  // 🚀 Puertos básicos
  "forwardPorts": [3000, 5173, 4000],
  
  "portsAttributes": {
    "3000": {"label": "Alimentacion App"},
    "5173": {"label": "Combustibles App"}, 
    "4000": {"label": "Firebase UI"}
  },
  
  // 🔧 Instalar Node.js
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "18"
    }
  },
  
  // 📦 Extensions mínimas
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "esbenp.prettier-vscode", 
        "dbaeumer.vscode-eslint"
      ]
    }
  },

  // 🔒 Usuario vscode (ya existe en base ubuntu)
  "remoteUser": "vscode",
  
  // 🌍 Variables mínimas
  "containerEnv": {
    "NODE_ENV": "development"
  },

  // 🔧 Config mínima
  "shutdownAction": "stopContainer"
}