{
  "name": "Forestech with User Creation",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-18-bullseye",
  
  // 🔧 Features para crear usuario vscode
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "configureZshAsDefaultShell": false,
      "installOhMyZsh": false,
      "upgradePackages": false,
      "username": "vscode",
      "userUid": "1000",
      "userGid": "1000"
    }
  },
  
  // 🚀 Puertos básicos
  "forwardPorts": [3000, 5173, 4000],
  
  "portsAttributes": {
    "3000": {"label": "Alimentacion App"},
    "5173": {"label": "Combustibles App"}, 
    "4000": {"label": "Firebase UI"}
  },
  
  // 📦 Extensions mínimas
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "esbenp.prettier-vscode", 
        "dbaeumer.vscode-eslint"
      ]
    }
  },

  // 🔒 Usuario vscode (creado por feature)
  "remoteUser": "vscode",
  
  // 🌍 Variables mínimas
  "containerEnv": {
    "NODE_ENV": "development"
  },

  // 🔧 Config mínima
  "shutdownAction": "stopContainer"
}