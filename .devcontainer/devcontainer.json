{
  "name": "Forestech Development Environment",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-18-bullseye",
  
  // 🏗️ Requerimientos de recursos optimizados
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  
  // 🔧 Features adicionales
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "upgradePackages": true,
      "username": "vscode",
      "userUid": "automatic",
      "userGid": "automatic"
    }
  },

  // 🚀 Configuración de puerto para desarrollo
  "forwardPorts": [
    3000,    // React dev server (alimentacion)
    5173,    // Vite dev server (combustibles)  
    5174,    // Vite dev server (shared)
    9005,    // Firebase emulator UI
    8080,    // Firebase Hosting emulator
    9099,    // Firebase Auth emulator
    8081     // Firebase Functions emulator
  ],
  
  "portsAttributes": {
    "3000": {
      "label": "Alimentacion App",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Combustibles App", 
      "onAutoForward": "notify"
    },
    "5174": {
      "label": "Shared Components",
      "onAutoForward": "silent"
    },
    "9005": {
      "label": "Firebase Emulator UI",
      "onAutoForward": "silent"
    }
  },

  // 📦 Extensiones de VS Code
  "customizations": {
    "vscode": {
      "extensions": [
        // 🎯 Esenciales
        "ms-vscode.vscode-typescript-next",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        
        // ⚛️ React & JavaScript
        "ms-vscode.vscode-json",
        "formulahendry.auto-rename-tag",
        "christian-kohler.path-intellisense",
        "ms-vscode.vscode-typescript-next",
        
        // 🔥 Firebase
        "toba.vsfire",
        "firebase.firebase-vscode",
        
        // 🐙 Git & GitHub
        "github.vscode-pull-request-github",
        "github.copilot",
        "github.copilot-chat",
        
        // 🎨 UI/UX
        "ms-vscode.vscode-icons",
        "pkief.material-icon-theme",
        "enkia.tokyo-night",
        
        // 🔧 Utilidades
        "ms-vscode.live-server",
        "ritwickdey.liveserver",
        "humao.rest-client",
        "redhat.vscode-yaml",
        "ms-vscode.hexeditor",
        
        // 📊 Análisis
        "ms-vscode.vscode-github-issue-notebooks",
        "github.vscode-github-actions",
        
        // 🧠 Claude Code (se instalará después)
        "claude-ai.claude-code"
      ],
      
      "settings": {
        // 🎨 Tema y apariencia
        "workbench.colorTheme": "Tokyo Night",
        "workbench.iconTheme": "material-icon-theme",
        
        // 📝 Editor
        "editor.fontSize": 14,
        "editor.lineHeight": 1.5,
        "editor.fontFamily": "'Cascadia Code', 'JetBrains Mono', 'Fira Code', monospace",
        "editor.fontLigatures": true,
        "editor.formatOnSave": true,
        "editor.formatOnPaste": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": true,
          "source.organizeImports": true
        },
        
        // 🔧 JavaScript/TypeScript
        "typescript.preferences.importModuleSpecifier": "relative",
        "javascript.preferences.importModuleSpecifier": "relative",
        "typescript.updateImportsOnFileMove.enabled": "always",
        "javascript.updateImportsOnFileMove.enabled": "always",
        
        // 💅 Prettier
        "prettier.singleQuote": true,
        "prettier.semi": true,
        "prettier.tabWidth": 2,
        "prettier.trailingComma": "es5",
        
        // 🧹 ESLint
        "eslint.workingDirectories": [
          "./alimentacion",
          "./combustibles", 
          "./shared"
        ],
        
        // 📁 Archivos
        "files.exclude": {
          "**/node_modules": true,
          "**/build": true,
          "**/dist": true,
          "**/.git": false,
          "**/coverage": true,
          "**/.env.local": true
        },
        
        // 🔍 Búsqueda
        "search.exclude": {
          "**/node_modules": true,
          "**/build": true,
          "**/dist": true,
          "**/coverage": true
        },
        
        // 🌟 Emmet
        "emmet.includeLanguages": {
          "javascript": "javascriptreact",
          "typescript": "typescriptreact"
        },
        
        // 🔥 Firebase
        "firebase.hosting.source": "./build",
        
        // 🐙 Git
        "git.autofetch": true,
        "git.enableSmartCommit": true,
        "git.confirmSync": false,
        
        // 📊 Breadcrumbs
        "breadcrumbs.enabled": true,
        
        // 🚀 Terminal
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh"
          }
        }
      }
    }
  },

  // 🚀 Scripts de inicialización
  "onCreateCommand": "bash .devcontainer/setup.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",

  // 🔒 Configuración de usuario y permisos
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": true,

  // 🗂️ Montajes y volúmenes
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localWorkspaceFolder}/.devcontainer/cache,target=/home/vscode/.cache,type=bind,consistency=cached"
  ],

  // 🌍 Variables de entorno con optimizaciones de memoria
  "containerEnv": {
    "NODE_ENV": "development",
    "FIREBASE_CONFIG_PATH": "/workspace/.firebase/config.json",
    "CLAUDE_WORKSPACE": "/workspace",
    // Optimizaciones Node.js para 8GB RAM
    "NODE_OPTIONS": "--max-old-space-size=6144 --max-semi-space-size=128",
    // Optimizaciones Vite
    "VITE_DEFINE": "globalThis",
    // Cache optimizations
    "npm_config_cache": "/workspace/.npm-cache",
    "yarn_cache_folder": "/workspace/.yarn-cache"
  },

  // ⚙️ Configuración del contenedor
  "shutdownAction": "stopContainer",
  "overrideCommand": false,
  "privileged": false,
  "init": true,

  // 🔧 Configuración adicional
  "capAdd": [
    "SYS_PTRACE"
  ]
}