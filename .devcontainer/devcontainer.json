{
  "name": "Forestech Root Fix",
  "image": "node:20-bullseye",
  
  // 🚀 Puertos básicos
  "forwardPorts": [3000, 5173, 4000],
  
  "portsAttributes": {
    "3000": {"label": "Alimentacion App"},
    "5173": {"label": "Combustibles App"}, 
    "4000": {"label": "Firebase UI"}
  },
  
  // 📦 Extensions mínimas
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "esbenp.prettier-vscode", 
        "dbaeumer.vscode-eslint"
      ]
    }
  },

  // 🚀 Optimizado para prebuilds
  "postCreateCommand": "bash .devcontainer/setup-prebuild.sh",
  "updateContentCommand": "echo 'Prebuild updated - dependencies already installed'",
  
  // 🔒 SIN especificar usuario - usar default (root)
  // "remoteUser": "vscode",  ← ESTO CAUSA EL ERROR
  
  // 🌍 Variables optimizadas para prebuilds
  "containerEnv": {
    "NODE_ENV": "development",
    "npm_config_cache": "/workspaces/forestech/.npm-cache",
    "npm_config_prefer_offline": "true",
    "npm_config_progress": "false",
    "npm_config_audit": "false"
  },

  // 🔧 Config optimizada
  "shutdownAction": "stopContainer",
  
  // 📦 Montajes para cache persistente
  "mounts": [
    "source=forestech-npm-cache,target=/workspaces/forestech/.npm-cache,type=volume"
  ]
}