{
  "name": "Forestech Minimal - Emergency Fix",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-18-bullseye",
  
  // ⚠️ CONFIGURACIÓN MÍNIMA - Solo lo esencial
  
  // 🚀 Puertos básicos
  "forwardPorts": [3000, 5173, 4000],
  
  "portsAttributes": {
    "3000": {"label": "Alimentacion App"},
    "5173": {"label": "Combustibles App"}, 
    "4000": {"label": "Firebase UI"}
  },
  
  // 📦 Extensions mínimas
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "esbenp.prettier-vscode", 
        "dbaeumer.vscode-eslint"
      ],
      
      "settings": {
        "editor.formatOnSave": true,
        "files.exclude": {
          "**/node_modules": true,
          "**/build": true,
          "**/dist": true
        }
      }
    }
  },

  // 🔒 Usuario simple
  "remoteUser": "vscode",
  
  // ⚙️ Sin comandos automáticos
  // Sin onCreateCommand, postCreateCommand, etc.
  
  // 🌍 Variables mínimas
  "containerEnv": {
    "NODE_ENV": "development"
  },

  // 🔧 Config mínima
  "shutdownAction": "stopContainer"
}