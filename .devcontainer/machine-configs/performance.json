{
  "name": "Forestech Performance (Premium)",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb", 
    "storage": "64gb"
  },
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=8192 --max-semi-space-size=256",
    "VITE_CACHE_DIR": "/workspace/.vite-cache",
    "ENVIRONMENT": "performance"
  },
  "description": "Para desarrollo intensivo, builds grandes, testing completo."
}