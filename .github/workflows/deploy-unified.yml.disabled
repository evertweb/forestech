name: 🚀 Deploy Unificado (Frontend + Cloud Run)

on:
  push:
    branches:
      - main

env:
  NODE_VERSION: '20'
  GCLOUD_PROJECT: 'liquidacionapp-62962'
  GCLOUD_REGION: 'us-central1'
  SERVICE_NAME: 'forestech-sql-service'

jobs:
  # 🏗️ BUILD FRONTEND
  build-frontend:
    name: 🏗️ Build Frontend
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: 📋 Checkout
        uses: actions/checkout@v4

      - name: ⚙️ Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'

      - name: 📦 Install dependencies
        run: npm ci --prefer-offline --no-audit --no-fund

      - name: ⛽ Build Combustibles
        run: |
          echo "⛽ Building Combustibles..."
          npm run build:combustibles
        env:
          NODE_OPTIONS: "--max-old-space-size=2048"
          VITE_FIREBASE_API_KEY: ${{ secrets.VITE_FIREBASE_API_KEY }}
          VITE_FIREBASE_AUTH_DOMAIN: liquidacionapp-62962.firebaseapp.com
          VITE_FIREBASE_PROJECT_ID: liquidacionapp-62962
          VITE_FIREBASE_STORAGE_BUCKET: liquidacionapp-62962.firebasestorage.app
          VITE_FIREBASE_MESSAGING_SENDER_ID: 851382130132
          VITE_FIREBASE_APP_ID: ${{ secrets.VITE_FIREBASE_APP_ID }}
          VITE_FIREBASE_MEASUREMENT_ID: ${{ secrets.VITE_FIREBASE_MEASUREMENT_ID }}
          CLOUD_RUN_SQL_URL: https://forestech-sql-service-851382130132.us-central1.run.app

      - name: 🍽️ Build Alimentacion
        run: |
          echo "🍽️ Building Alimentacion..."
          npm run build:alimentacion
        env:
          NODE_OPTIONS: "--max-old-space-size=2048"

      - name: 📤 Upload build artifacts
        uses: actions/upload-artifact@v4
        with:
          name: frontend-build
          path: |
            public/
            alimentacion/dist/
            combustibles/dist/
          retention-days: 1

  # 🚀 DEPLOY CLOUD RUN
  deploy-cloud-run:
    name: 🚀 Deploy Cloud Run
    runs-on: ubuntu-latest
    timeout-minutes: 15
    needs: build-frontend

    steps:
      - name: 📋 Checkout
        uses: actions/checkout@v4

      - name: 🔐 Authenticate to Google Cloud
        uses: google-github-actions/auth@v2
        with:
          credentials_json: ${{ secrets.GCP_SA_KEY }}

      - name: ⚙️ Setup Google Cloud SDK
        uses: google-github-actions/setup-gcloud@v2
        with:
          project_id: ${{ env.GCLOUD_PROJECT }}

      - name: 📦 Install dependencies
        run: |
          cd functions
          npm ci --prefer-offline --no-audit --no-fund

      - name: 🏗️ Deploy to Cloud Run
        run: |
          echo "🚀 Deploying to Cloud Run..."
          gcloud run deploy ${{ env.SERVICE_NAME }} \
            --source . \
            --platform managed \
            --region ${{ env.GCLOUD_REGION }} \
            --project ${{ env.GCLOUD_PROJECT }} \
            --allow-unauthenticated \
            --memory 512Mi \
            --cpu 1 \
            --max-instances 10 \
            --port 8080 \
            --set-env-vars="NODE_ENV=production" \
            --set-env-vars="FIREBASE_PROJECT_ID=${{ env.GCLOUD_PROJECT }}" \
            --set-env-vars="GCLOUD_PROJECT=${{ env.GCLOUD_PROJECT }}"

      - name: ✅ Verify Cloud Run
        run: |
          SERVICE_URL=$(gcloud run services describe ${{ env.SERVICE_NAME }} \
            --region ${{ env.GCLOUD_REGION }} \
            --project ${{ env.GCLOUD_PROJECT }} \
            --format="value(status.url)")

          echo "🌐 Cloud Run URL: $SERVICE_URL"

          if curl -f "$SERVICE_URL/health" > /dev/null 2>&1; then
            echo "✅ Cloud Run health check passed!"
          else
            echo "❌ Cloud Run health check failed!"
            exit 1
          fi

  # 🌐 DEPLOY FRONTEND TO FIREBASE
  deploy-frontend:
    name: 🌐 Deploy Frontend
    runs-on: ubuntu-latest
    timeout-minutes: 10
    needs: [build-frontend, deploy-cloud-run]

    steps:
      - name: 📋 Checkout
        uses: actions/checkout@v4

      - name: 📥 Download build artifacts
        uses: actions/download-artifact@v4
        with:
          name: frontend-build
          path: .

      - name: 🔧 Setup Firebase CLI
        run: npm install -g firebase-tools@13.0.0

      - name: 🔑 Authenticate Firebase
        run: |
          echo '${{ secrets.FIREBASE_SERVICE_ACCOUNT_LIQUIDACIONAPP_62962 }}' > /tmp/service-account.json
          firebase use liquidacionapp-62962 --token ${{ secrets.FIREBASE_TOKEN }}

      - name: 🚀 Deploy to Firebase Hosting
        run: |
          echo "🚀 Deploying frontend to Firebase..."
          firebase deploy --only hosting --token ${{ secrets.FIREBASE_TOKEN }} --json | tee deploy-result.json

          if grep -q '"status": "success"' deploy-result.json; then
            echo "✅ Frontend deploy successful!"
          else
            echo "❌ Frontend deploy failed!"
            cat deploy-result.json
            exit 1
          fi

  # 📊 SUMMARY
  summary:
    name: 📊 Deployment Summary
    runs-on: ubuntu-latest
    needs: [build-frontend, deploy-cloud-run, deploy-frontend]
    if: always()

    steps:
      - name: 📊 Generate Summary
        run: |
          echo "🎉 Deployment Summary"
          echo "════════════════════"
          echo "✅ Frontend: Built and deployed to Firebase"
          echo "✅ Cloud Run: Deployed and verified"
          echo "✅ Integration: Complete"
          echo ""
          echo "🌐 URLs:"
          echo "  Frontend: https://forestech-combustibles.web.app"
          echo "  Cloud Run: https://forestech-sql-service-851382130132.us-central1.run.app"
          echo ""
          echo "📊 Services:"
          echo "  - 35 SQL endpoints available"
          echo "  - Firebase Auth integrated"
          echo "  - Azure SQL connected"
          echo ""
          echo "🚀 Deployment completed successfully!"