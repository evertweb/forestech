name: 🚀 Forestech Manual Deploy TURBO

on:
  workflow_dispatch:
    inputs:
      deploy_target:
        description: 'What to deploy'
        required: true
        default: 'all'
        type: choice
        options:
          - all
          - combustibles
          - alimentacion
          - hosting-only
      skip_tests:
        description: 'Skip tests (faster deploy)'
        required: false
        default: false
        type: boolean

env:
  NODE_VERSION: '20'

jobs:
  deploy:
    name: 🚀 Deploy Forestech
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      # 📋 CHECKOUT
      - name: 📋 Checkout Repository
        uses: actions/checkout@v4

      # ⚙️ SETUP NODE
      - name: ⚙️ Setup Node.js ${{ env.NODE_VERSION }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'

      # 📦 INSTALL DEPENDENCIES (with cache)
      - name: 📦 Install Dependencies (Cached)
        run: |
          echo "📦 Installing dependencies with cache..."
          npm ci --prefer-offline --no-audit --no-fund

      # 🔍 LINT (only if not skipping tests)
      - name: 🔍 Lint Code
        if: github.event.inputs.skip_tests != 'true'
        run: |
          echo "🔍 Running lint checks..."
          npm run lint:check

      # 🏗️ BUILD APPLICATIONS
      - name: 🏗️ Build Applications
        run: |
          echo "🏗️ Building applications..."
          
          if [ "${{ github.event.inputs.deploy_target }}" = "all" ] || [ "${{ github.event.inputs.deploy_target }}" = "combustibles" ]; then
            echo "⛽ Building Combustibles..."
            npm run build:combustibles
          fi
          
          if [ "${{ github.event.inputs.deploy_target }}" = "all" ] || [ "${{ github.event.inputs.deploy_target }}" = "alimentacion" ]; then
            echo "🍽️ Building Alimentacion..."
            npm run build:alimentacion
          fi
        env:
          NODE_OPTIONS: "--max-old-space-size=2048"
          VITE_FIREBASE_API_KEY: ${{ secrets.VITE_FIREBASE_API_KEY }}
          VITE_FIREBASE_AUTH_DOMAIN: liquidacionapp-62962.firebaseapp.com
          VITE_FIREBASE_PROJECT_ID: liquidacionapp-62962
          VITE_FIREBASE_STORAGE_BUCKET: liquidacionapp-62962.firebasestorage.app
          VITE_FIREBASE_MESSAGING_SENDER_ID: 851382130132
          VITE_FIREBASE_APP_ID: ${{ secrets.VITE_FIREBASE_APP_ID }}
          VITE_FIREBASE_MEASUREMENT_ID: ${{ secrets.VITE_FIREBASE_MEASUREMENT_ID }}

      # 🔧 SETUP FIREBASE CLI
      - name: 🔧 Setup Firebase CLI
        run: |
          npm install -g firebase-tools@13.0.0
          firebase --version

      # 🚀 DEPLOY TO FIREBASE
      - name: 🚀 Deploy to Firebase Hosting
        run: |
          echo "🚀 Deploying to Firebase Hosting..."
          
          # Determine what to deploy
          if [ "${{ github.event.inputs.deploy_target }}" = "all" ]; then
            DEPLOY_TARGETS="hosting:forestechdecolombia,hosting:combustibles-subdomain"
          elif [ "${{ github.event.inputs.deploy_target }}" = "combustibles" ]; then
            DEPLOY_TARGETS="hosting:combustibles-subdomain"
          elif [ "${{ github.event.inputs.deploy_target }}" = "alimentacion" ]; then
            DEPLOY_TARGETS="hosting:forestechdecolombia"
          elif [ "${{ github.event.inputs.deploy_target }}" = "hosting-only" ]; then
            DEPLOY_TARGETS="hosting"
          fi
          
          echo "📋 Deploy targets: $DEPLOY_TARGETS"
          
          firebase deploy --only "$DEPLOY_TARGETS" --token ${{ secrets.FIREBASE_TOKEN }} --json | tee deploy-result.json
          
          # Check result
          if grep -q '"status": "success"' deploy-result.json; then
            echo "✅ Deploy successful!"
          else
            echo "❌ Deploy failed!"
            cat deploy-result.json
            exit 1
          fi

      # 🔍 VERIFY DEPLOYMENT
      - name: 🔍 Verify Deployment
        run: |
          echo "🔍 Verifying deployment..."
          
          # Test main domains
          if [ "${{ github.event.inputs.deploy_target }}" = "all" ] || [ "${{ github.event.inputs.deploy_target }}" = "combustibles" ]; then
            echo "⛽ Testing Combustibles..."
            curl -f "https://combustibles.forestechdecolombia.com.co/" > /dev/null && echo "✅ Custom domain OK" || echo "⚠️ Custom domain check failed"
            curl -f "https://combustibles-subdomain.web.app/" > /dev/null && echo "✅ Firebase domain OK" || echo "⚠️ Firebase domain check failed"
          fi
          
          if [ "${{ github.event.inputs.deploy_target }}" = "all" ] || [ "${{ github.event.inputs.deploy_target }}" = "alimentacion" ]; then
            echo "🍽️ Testing Alimentacion..."
            curl -f "https://forestechdecolombia.web.app/" > /dev/null && echo "✅ Main domain OK" || echo "⚠️ Main domain check failed"
          fi

      # 📊 DEPLOYMENT SUMMARY
      - name: 📊 Deployment Summary
        if: always()
        run: |
          echo "📊 Deployment Summary:"
          echo "🎯 Target: ${{ github.event.inputs.deploy_target }}"
          echo "⚡ Skip tests: ${{ github.event.inputs.skip_tests }}"
          echo "⏱️ Started: ${{ job.started_at }}"
          echo "🌐 URLs deployed:"
          
          if [ "${{ github.event.inputs.deploy_target }}" = "all" ] || [ "${{ github.event.inputs.deploy_target }}" = "combustibles" ]; then
            echo "  ⛽ https://combustibles.forestechdecolombia.com.co/"
            echo "  ⛽ https://combustibles-subdomain.web.app/"
          fi
          
          if [ "${{ github.event.inputs.deploy_target }}" = "all" ] || [ "${{ github.event.inputs.deploy_target }}" = "alimentacion" ]; then
            echo "  🍽️ https://forestechdecolombia.web.app/"
          fi
          
          echo "✅ Manual deploy completed!"