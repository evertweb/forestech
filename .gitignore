# ========================================
# FORESTECH CI/CD SECURITY - .gitignore
# ========================================

# 🔒 SECURITY - Environment variables and secrets
.env
.env.local
.env.production
.env.development
.env.staging
.env.*
!.env.example

# 🔒 SECURITY - Function environment files
functions/.env
functions/.env.*
!functions/.env.example

# 🔒 SECURITY - Component environment files
combustibles/.env
combustibles/.env.*
!combustibles/.env.example
alimentacion/.env
alimentacion/.env.*
!alimentacion/.env.example

# 🔒 SECURITY - Test environment files (pueden contener API keys)
**/.env.e2e
**/.env.test
**/.env.local

# 🔒 SECURITY - API keys and tokens
**/api-keys.json
**/service-account.json
**/firebase-adminsdk*.json

# 🔒 SECURITY - Backup files que pueden contener secrets
*.backup
*.bak
*.old

# Firebase cache
.firebase/

# Node modules
node_modules/

# MCP Configuration files (contienen API keys)
.vscode/notion.env
.vscode/memory.json

# IDE files específicos (pero mantener .vscode/mcp.json)
.vscode/settings.json
.vscode/launch.json
.idea/

# OS generated files
.DS_Store
Thumbs.db

# MCP Memory files
.mcp-memory/
*.mcp-memory.json

# Logs
*.log
npm-debug.log*

# Build assets (generated files)
public/combustibles/assets/
public/alimentacion/assets/

fetch-mcp/

# Test artifacts
combustibles/test-results/
combustibles/playwright-report/
combustibles/coverage/
**/coverage/

# Performance reports (pueden ser regenerados)
performance-*.md
security-audit-report.md
scripts-cleanup-report.md

# Firebase optimizations
.firebase/
firebase-debug.log
firebase-debug.*.log
.cache-deploy/
deploy-result.json
firebase.json.backup

# Build optimizations
node_modules/.cache/
.vite/
.eslintcache
