# ========================================
# FORESTECH CI/CD SECURITY - .gitignore
# ========================================

# 🔒 SECURITY - Environment variables and secrets
.env
.env.local
.env.production
.env.development
.env.staging
.env.*

# 🔒 SECURITY - Test environment files (pueden contener API keys)
**/.env.e2e
**/.env.test
**/.env.local

# 🔒 SECURITY - API keys and tokens
**/api-keys.json
**/service-account.json
**/firebase-adminsdk*.json

# 🔒 SECURITY - Backup files que pueden contener secrets
*.backup
*.bak
*.old

# Firebase cache
.firebase/

# Node modules
node_modules/

# MCP Configuration files (contienen API keys)
.vscode/notion.env
.vscode/memory.json

# IDE files específicos (pero mantener .vscode/mcp.json)
.vscode/settings.json
.vscode/launch.json
.idea/

# OS generated files
.DS_Store
Thumbs.db

# MCP Memory files
.mcp-memory/
*.mcp-memory.json

# Logs
*.log
npm-debug.log*

fetch-mcp/
# Test artifacts
**/coverage/

# Firebase caches
.firebase/
firebase-debug.log
firebase-debug.*.log

# Deploy caches
.cache-deploy/
deploy-result.json

# Build caches
node_modules/.cache/
.vite/
.eslintcache
