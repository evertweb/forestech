#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# 🚀 PRE-COMMIT UNIFICADO - Test + Lint + Build + Deploy Automático
echo "🔄 Ejecutando pre-commit unificado..."

# Ejecutar el script unificado
./scripts/precommit-unified.sh

# Si el script falla, el commit se cancela automáticamente
if [ $? -ne 0 ]; then
  echo "❌ Pre-commit falló. Commit cancelado."
  exit 1
fi

echo "✅ Pre-commit completado. Continuando con commit..."
