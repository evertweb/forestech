{
  "name": "combustibles",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node load-env.js && vite",
    "dev:safe": "node -e \"require('./load-env.js')\" && vite",
    "build": "node load-env.js && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "setup:migration": "./setup-migration.sh",
    "e2e": "playwright test",
    "check-env": "node load-env.js",
    "dev:codespace": "./dev-codespace.sh",
    "type-check": "cd .. && ./node_modules/.bin/tsc --project combustibles/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "firebase": "^12.3.0",
    "framer-motion": "^12.23.22",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.3",
    "rollup-plugin-visualizer": "^6.0.3",
    "tailwindcss-react-aria-components": "^2.0.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "typescript": "^5.9.3",
    "vite": "^4.4.5"
  }
}
