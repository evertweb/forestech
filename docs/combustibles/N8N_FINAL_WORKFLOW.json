    {
      "parameters": {
        "functionCode": "// PROCESADOR DE TELEGRAM PARA FORESTECH - VERSIÓN FASE 1\nconst update = $json.body || $json;\nconsole.log('🔔 Webhook recibido:', JSON.stringify(update, null, 2));\n\nconst msg = update.message;\nconst cbq = update.callback_query;\n\nif (!msg && !cbq) {\n  console.log('❌ No es un mensaje ni callback, ignorando');\n  return [];\n}\n\nconst text = (msg?.text || '').trim();\nconst chatId = msg?.chat?.id || cbq?.message?.chat?.id;\nconst from = msg?.from || cbq?.from || {};\nconst userId = from.id;\nconst username = from.username || from.first_name || 'user';\n\n// Comandos soportados\nconst command = text.startsWith('/') ? text.split(' ')[0].toLowerCase() : null;\n\n// /help\nif (command === '/help' || command === '/start') {\n  return [{ json: { action: 'send_message', chatId, message: `🤖 **ForeTech Combustibles Bot**\\n\\nComandos rápidos:\\n/entrada - Iniciar asistente de ENTRADA\\n/login - Vincular tu cuenta\\n/help - Ayuda\\n` } }];\n}\n\n// /login\nif (command === '/login') {\n  return [{ json: { action: 'login_init', telegramData: { chatId, userId, username } } }];\n}\n\n// /entrada\nif (command === '/entrada' || /entrada/i.test(text)) {\n  return [{ json: { action: 'start_wizard', telegramData: { chatId, userId, username }, session: { chatId } } }];\n}\n\n// Callback data (inline keyboards) → continuar flujo\nif (cbq?.data) {\n  return [{ json: { action: 'continue', telegramData: { chatId, userId, username }, session: { chatId }, input: { callback: cbq.data } } }];\n}\n\n// Entrada libre → continuar flujo (pasos que requieren texto)\nif (text) {\n  return [{ json: { action: 'continue', telegramData: { chatId, userId, username }, session: { chatId }, input: { text } } }];\n}\n\nreturn [{ json: { action: 'send_message', chatId, message: 'No entendí. Usa /help.' } }];\n"
      },
      "name": "Procesar Telegram",
