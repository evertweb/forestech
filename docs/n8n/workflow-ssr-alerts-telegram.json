        "options": {}
      },
      "id": "telegram-critical",
      "name": "Telegram Critical Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [680, 500]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"status\": \"success\",\n  \"message\": \"Alert processed successfully\",\n  \"timestamp\": \"{{ new Date().toISOString() }}\",\n  \"alert_id\": \"{{ $json.alert_id || 'auto-generated' }}\",\n  \"severity\": \"{{ $json.severity }}\",\n  \"notifications_sent\": {\n    \"email\": true,\n    \"telegram\": \"{{ $json.severity === 'critical' }}\"\n  }\n}"
      },
      "id": "webhook-response",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 300]
    }
