{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "forestechdecolombia",
      "public": "public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Powered-By",
              "value": "Forestech Colombia"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/robots.txt",
          "destination": "/seo-robots",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/",
          "destination": "/index.html"
        },
        {
          "source": "/alimentacion/**",
          "destination": "/alimentacion/index.html"
        },
        {
          "source": "/sitemap.xml",
          "function": "ssrCombustibles"
        },
        {
          "source": "/sitemap-*.xml",
          "function": "ssrCombustibles"
        },
        {
          "source": "/seo-robots",
          "function": "ssrCombustibles"
        },
        {
          "source": "/test-robots-hosting",
          "function": "ssrCombustibles"
        },
        {
          "source": "/combustibles/ssr-health",
          "function": "ssrCombustibles"
        },
        {
          "source": "/ab-testing",
          "function": "ssrCombustibles"
        },
        {
          "source": "/health",
          "function": "ssrCombustibles"
        },
        {
          "source": "/seo-validation",
          "function": "ssrCombustibles"
        },
        {
          "source": "/movement-wizard-popup",
          "function": "ssrCombustibles"
        },
        {
          "source": "/vehicle-wizard-popup",
          "function": "ssrCombustibles"
        },
        {
          "source": "/combustibles/assets/**",
          "destination": "/combustibles/assets/:splat"
        },
        {
          "source": "/combustibles/src/**",
          "destination": "/combustibles/src/:splat"
        },
        {
          "source": "/combustibles/**",
          "function": "ssrCombustibles"
        }
      ]
    },
    {
      "target": "liquidacionapp-62962",
      "public": "public-legacy",
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
