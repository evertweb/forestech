{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "forestechdecolombia",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Powered-By",
            "value": "Forestech Colombia"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/robots.txt",
        "destination": "/seo-robots",
        "type": 301
      },
      {
        "source": "/combustibles/politica-privacidad",
        "destination": "/legal/politica-privacidad.html",
        "type": 301
      },
      {
        "source": "/combustibles/terminos-servicio",
        "destination": "/legal/terminos-servicio.html",
        "type": 301
      },
      {
        "source": "/politica-privacidad",
        "destination": "/legal/politica-privacidad.html",
        "type": 301
      },
      {
        "source": "/terminos-servicio",
        "destination": "/legal/terminos-servicio.html",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/index.html"
      },
      {
        "source": "/firebase-web-authn-api",
        "function": "ext-firebase-web-authn-api"
      },
      {
        "source": "/combustibles/firebase-web-authn-api",
        "function": "ext-firebase-web-authn-api"
      },
      {
        "source": "/combustibles/**",
        "destination": "/combustibles/index.html"
      },
      {
        "source": "/alimentacion/**",
        "destination": "/alimentacion/index.html"
      },
      {
        "source": "/sitemap.xml",
        "function": "ssrCombustibles"
      },
      {
        "source": "/sitemap-*.xml",
        "function": "ssrCombustibles"
      },
      {
        "source": "/seo-robots",
        "function": "ssrCombustibles"
      },
      {
        "source": "/test-robots-hosting",
        "function": "ssrCombustibles"
      },
      {
        "source": "/health",
        "function": "ssrCombustibles"
      },
      {
        "source": "/ab-testing",
        "function": "ssrCombustibles"
      },
      {
        "source": "/error-stats",
        "function": "ssrCombustibles"
      },
      {
        "source": "/ssr-reports",
        "function": "ssrCombustibles"
      },
      {
        "source": "/ssr-alerts",
        "function": "ssrCombustibles"
      },
      {
        "source": "/ssr-optimization",
        "function": "ssrCombustibles"
      },
      {
        "source": "/ssr-coverage",
        "function": "ssrCombustibles"
      },
      {
        "source": "/seo-validation",
        "function": "ssrCombustibles"
      },
      {
        "source": "/combustibles/ssr-health",
        "function": "ssrCombustibles"
      },
      {
        "source": "/combustibles/ssr-status",
        "function": "ssrCombustibles"
      }
    ]
  },
  "extensions": {
    "firebase-web-authn": "gavinsawyer/firebase-web-authn@10.4.2",
    "forestech": "gavinsawyer/firebase-web-authn@10.4.2"
  }
}
