// Reglas temporales para debugging - SOLO DESARROLLO
// Permite lectura sin autenticación para resolver el problema de las cards

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // TEMPORAL: Permitir lectura sin autenticación para combustibles
    match /combustibles_{collection}/{document} {
      allow read: if true; // SOLO PARA DEBUGGING
      allow write: if request.auth != null; // Escritura sigue requiriendo auth
    }
    
    // Otras colecciones siguen requiriendo autenticación
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}