rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // REGLAS PARA FIREBASE WEB AUTHN EXTENSION (Legacy)
    match /webAuthnCredentials/{credentialId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /webAuthnUsers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // REGLAS PARA NUEVO SISTEMA DE PASSKEYS
    match /passkey_credentials/{credentialId} {
      allow read, write: if request.auth != null;
      // Permitir lectura para buscar credenciales durante autenticación
      allow read: if true;
    }

    match /passkey_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Permitir lectura para verificar usuarios durante autenticación
      allow read: if true;
    }

    // TEMPORAL: Permitir lectura sin autenticación para combustibles (SOLO DEBUGGING)
    match /combustibles_inventory/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /combustibles_vehicles/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /combustibles_movements/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /combustibles_suppliers/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /combustibles_products/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /combustibles_vehicle_categories/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Otras colecciones siguen requiriendo autenticación
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
