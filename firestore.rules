rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // TEMPORAL: Permitir lectura sin autenticación para combustibles (SOLO DEBUGGING)
    match /combustibles_inventory/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /combustibles_vehicles/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /combustibles_movements/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /combustibles_suppliers/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /combustibles_products/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /combustibles_vehicle_categories/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Otras colecciones siguen requiriendo autenticación
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}