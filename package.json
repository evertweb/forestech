{
  "name": "forestech",
  "version": "1.0.0",
  "description": "Forestech Colombia - Monorepo de aplicaciones web",
  "main": "index.js",
  "workspaces": [
    "alimentacion",
    "combustibles"
  ],
  "scripts": {
    "dev:alimentacion": "npm run dev --workspace=alimentacion",
    "dev:combustibles": "npm run dev --workspace=combustibles",
    "build:alimentacion": "npm run build --workspace=alimentacion",
    "build:combustibles": "npm run build --workspace=combustibles",
    "build:all": "npm run build:alimentacion && npm run build:combustibles",
    "build:parallel": "npm run build --workspace=alimentacion & npm run build --workspace=combustibles & wait",
    "build": "npm run build:all",
    "build:incremental": "./scripts/build-incremental.sh",
    "build:smart": "./scripts/build-incremental.sh",
    "lint:alimentacion": "npm run lint --workspace=alimentacion",
    "lint:combustibles": "cd combustibles && npm run lint --if-present",
    "lint:all": "npm run lint:alimentacion && npm run lint:combustibles",
    "lint:check": "npm run lint:all",
    "lint": "npm run lint:check",
    "test": "echo 'Tests delegated to GitHub Actions' && exit 0",
    "test:ci": "npm run test --workspace=alimentacion --if-present && npm run test --workspace=combustibles --if-present",
    "favicons:generate": "echo 'Favicons already generated. Use existing files in public/'",
    "favicons:copy": "npm run favicons:generate && npm run build:all && cp public/favicon-alimentacion.svg public/alimentacion/ && cp public/favicon-combustibles.svg public/combustibles/",
    "deploy": "npm run build:all && firebase deploy",
    "deploy:smart": "./scripts/deploy-smart.sh",
    "deploy:fast": "npm run build:incremental && firebase deploy --only hosting",
    "deploy:turbo": "./scripts/deploy-turbo-local.sh",
    "deploy:turbo-force": "./scripts/deploy-turbo-local.sh --force",
    "deploy:measure": "./scripts/measure-deploy-performance.sh",
    "deploy:clean": "./scripts/clean-for-deploy.sh && npm run deploy:turbo",
    "deploy:incremental": "./scripts/build-incremental.sh && firebase deploy --only hosting",
    "clean": "./scripts/clean-cache.sh",
    "clean:build": "./scripts/clean-cache.sh && npm run build:all",
    "serve:ssr": "cd functions && npm run serve",
    "deploy:ssr": "cd functions && npm run deploy",
    "perf:budget": "./scripts/performance-budget-check.sh",
    "perf:optimize": "./scripts/optimize-performance.sh",
    "test:rollback": "node scripts/test-remote-config-rollback.js",
    "test:ssr-validation": "npx playwright test tests-e2e/ssr-validation.spec.ts",
    "install:all": "npm ci",
    "prepare": "husky || exit 0",
    "lint-staged": "lint-staged"
  },
  "private": true,
  "dependencies": {
    "chart.js": "^4.5.0",
    "dotenv": "^17.2.0",
    "firebase": "^11.9.1",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-admin": "^13.4.0",
    "globals": "^16.0.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "vite": "^6.3.5"
  },
  "lint-staged": {
    "*.{css,md,json}": [
      "prettier --write"
    ],
    "alimentacion/**/*.{js,jsx}": [
      "prettier --write",
      "bash -c 'cd alimentacion && npx eslint --fix src/**/*.{js,jsx}'"
    ],
    "combustibles/**/*.{js,jsx}": [
      "prettier --write",
      "bash -c 'cd combustibles && npx eslint --fix src/**/*.{js,jsx}'"
    ]
  }
}
