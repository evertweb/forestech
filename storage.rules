// Reglas de Firebase Storage para Forestech
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permitir lectura y escritura para iconos de categorías
    match /category-icons/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Permitir lectura y escritura para imágenes de alimentación
    match /alimentacion/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Permitir lectura y escritura para imágenes de combustibles
    match /combustibles/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Permitir lectura y escritura para archivos de usuarios autenticados
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Permitir lectura pública para ciertos archivos
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}